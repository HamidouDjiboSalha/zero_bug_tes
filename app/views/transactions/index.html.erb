<% content_for :page_title, "Journal / Historique" %>

<style>
  :root {
    --lime: #8dc63f;
    --lime-dark: #6fa32e;
    --lime-muted: #e8f5d0;
    --amber: #f59e0b;
    --amber-dark: #d97706;
    --amber-muted: #fef3c7;
    --charcoal: #1c1f26;
  }
  body { font-family: 'Outfit', sans-serif; }

  /* ── Page header ── */
  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 14px;
  }

  .page-header h1 {
    font-size: 20px;
    font-weight: 700;
    color: var(--charcoal);
    margin: 0 0 4px;
    letter-spacing: -0.3px;
  }

  .page-header p { font-size: 13px; color: #9ca3af; margin: 0; }

  /* ── KPI row ── */
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
    margin-bottom: 28px;
  }

  .kpi-card {
    background: white;
    border-radius: 14px;
    padding: 18px 20px;
    box-shadow: 0 2px 12px rgba(28,31,38,0.06);
    border: 1.5px solid #f0f0f0;
    position: relative;
    overflow: hidden;
  }

  .kpi-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    border-radius: 14px 14px 0 0;
  }

  .kpi-card.deposit::before  { background: var(--lime); }
  .kpi-card.withdraw::before { background: var(--amber); }
  .kpi-card.total::before    { background: var(--charcoal); }

  .kpi-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #9ca3af;
    margin-bottom: 8px;
  }

  .kpi-value {
    font-size: 22px;
    font-weight: 700;
    color: var(--charcoal);
    letter-spacing: -0.5px;
    line-height: 1;
  }

  .kpi-value span { font-size: 12px; font-weight: 500; color: #9ca3af; margin-left: 3px; }

  /* ── Tabs ── */
  .tabs {
    display: flex;
    gap: 4px;
    background: white;
    border-radius: 12px;
    padding: 5px;
    border: 1.5px solid #f0f0f0;
    box-shadow: 0 2px 8px rgba(28,31,38,0.05);
    width: fit-content;
    margin-bottom: 18px;
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 18px;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 600;
    font-family: 'Outfit', sans-serif;
    border: none;
    cursor: pointer;
    transition: all 0.15s;
    color: #6b7280;
    background: transparent;
  }

  .tab-btn svg { width: 14px; height: 14px; }

  .tab-btn.active.deposit  { background: var(--lime-muted);  color: var(--lime-dark); }
  .tab-btn.active.withdraw { background: var(--amber-muted); color: var(--amber-dark); }
  .tab-btn:not(.active):hover { background: #f9fafb; color: var(--charcoal); }

  .tab-count {
    font-size: 10.5px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 99px;
    background: rgba(0,0,0,0.07);
  }

  /* ── Table card ── */
  .table-card {
    background: white;
    border-radius: 16px;
    box-shadow: 0 2px 20px rgba(28,31,38,0.07);
    border: 1.5px solid #f0f0f0;
    overflow: hidden;
  }

  .table-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1.5px solid #f3f4f6;
    gap: 12px;
    flex-wrap: wrap;
  }

  .search-wrap {
    position: relative;
    flex: 1;
    max-width: 300px;
    min-width: 160px;
  }

  .search-wrap svg {
    position: absolute;
    left: 11px; top: 50%;
    transform: translateY(-50%);
    width: 14px; height: 14px;
    color: #9ca3af;
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 8px 12px 8px 32px;
    border: 1.5px solid #e5e7eb;
    border-radius: 9px;
    font-size: 13px;
    font-family: 'Outfit', sans-serif;
    color: var(--charcoal);
    background: #fafafa;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .search-input:focus {
    border-color: var(--lime);
    box-shadow: 0 0 0 3px rgba(141,198,63,0.12);
    background: white;
  }

  .filter-wrap { display: flex; gap: 6px; flex-wrap: wrap; }

  .filter-btn {
    padding: 6px 12px;
    border-radius: 7px;
    font-size: 11.5px;
    font-weight: 600;
    font-family: 'Outfit', sans-serif;
    border: 1.5px solid #e5e7eb;
    background: white;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.12s;
  }

  .filter-btn.active,
  .filter-btn:hover {
    border-color: var(--lime);
    color: var(--lime-dark);
    background: var(--lime-muted);
  }

  /* ── Data table ── */
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .data-table thead {
    background: #f8faf5;
    border-bottom: 1.5px solid #e8f5d0;
  }

  .data-table.withdraw-table thead {
    background: #fffdf5;
    border-bottom: 1.5px solid #fde68a;
  }

  .data-table thead th {
    padding: 11px 16px;
    text-align: left;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #9ca3af;
    white-space: nowrap;
  }

  .data-table tbody tr {
    border-bottom: 1px solid #f3f4f6;
    transition: background 0.1s;
  }

  .data-table tbody tr:last-child { border-bottom: none; }
  .data-table tbody tr:hover { background: #fafdf6; }
  .data-table.withdraw-table tbody tr:hover { background: #fffdf5; }

  .data-table td {
    padding: 12px 16px;
    color: var(--charcoal);
    vertical-align: middle;
  }

  .td-date { color: #6b7280; font-size: 12px; white-space: nowrap; }

  .td-agent {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .agent-avatar {
    width: 28px; height: 28px;
    border-radius: 8px;
    background: var(--charcoal);
    color: white;
    font-size: 11px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .agent-email { font-size: 12.5px; font-weight: 500; color: #374151; }

  .td-phone {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    white-space: nowrap;
  }

  .phone-avatar {
    width: 28px; height: 28px;
    border-radius: 7px;
    font-size: 11px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .avatar-dep { background: var(--lime-muted); color: var(--lime-dark); }
  .avatar-wit { background: var(--amber-muted); color: var(--amber-dark); }

  .td-amount { font-weight: 700; font-size: 13.5px; white-space: nowrap; }
  .amount-dep { color: var(--lime-dark); }
  .amount-wit { color: var(--amber-dark); }

  .td-ref {
    font-family: 'Courier New', monospace;
    font-size: 11.5px;
    color: #9ca3af;
    background: #f3f4f6;
    padding: 3px 8px;
    border-radius: 6px;
    white-space: nowrap;
    display: inline-block;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border-radius: 99px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }

  .status-badge::before {
    content: '';
    width: 5px; height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .status-validated  { background: var(--lime-muted); color: var(--lime-dark); }
  .status-validated::before { background: var(--lime); }
  .status-pending    { background: var(--amber-muted); color: var(--amber-dark); }
  .status-pending::before { background: var(--amber); }
  .status-rejected   { background: #fef2f2; color: #dc2626; }
  .status-rejected::before { background: #ef4444; }
  .status-default    { background: #f3f4f6; color: #6b7280; }
  .status-default::before { background: #9ca3af; }

  /* ── Panels ── */
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* ── Empty ── */
  .empty-state { padding: 44px 32px; text-align: center; }
  .empty-icon {
    width: 50px; height: 50px;
    background: #f3f4f6;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 12px;
  }
  .empty-icon svg { width: 24px; height: 24px; color: #d1d5db; }
  .empty-state p { color: #9ca3af; font-size: 14px; margin: 0; }
</style>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- ── Page header ── -->
<div class="page-header">
  <div>
    <h1>Journal des transactions</h1>
    <p>Historique complet de toutes les opérations enregistrées</p>
  </div>
</div>

<!-- ── KPI row ── -->
<div class="kpi-row">
  <div class="kpi-card deposit">
    <div class="kpi-label">Total dépôts</div>
    <div class="kpi-value">
      + <%= number_with_delimiter(@deposits.sum(&:amount), delimiter: " ") %>
      <span>FCFA</span>
    </div>
  </div>
  <div class="kpi-card withdraw">
    <div class="kpi-label">Total retraits</div>
    <div class="kpi-value">
      − <%= number_with_delimiter(@withdrawals.sum(&:amount), delimiter: " ") %>
      <span>FCFA</span>
    </div>
  </div>
  <div class="kpi-card total">
    <div class="kpi-label">Transactions totales</div>
    <div class="kpi-value">
      <%= @deposits.size + @withdrawals.size %>
      <span>opérations</span>
    </div>
  </div>
</div>

<!-- ── Tabs ── -->
<div class="tabs">
  <button class="tab-btn active deposit" onclick="switchTab('deposits', this)">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
    </svg>
    Dépôts
    <span class="tab-count"><%= @deposits.size %></span>
  </button>
  <button class="tab-btn withdraw" onclick="switchTab('withdrawals', this)">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
    </svg>
    Retraits
    <span class="tab-count"><%= @withdrawals.size %></span>
  </button>
</div>

<!-- ══════════════ DÉPÔTS PANEL ══════════════ -->
<div class="tab-panel active" id="panel-deposits">
  <div class="table-card">
    <div class="table-toolbar">
      <div class="search-wrap">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input type="text" class="search-input" id="search-deposits" placeholder="Agent, client, référence…">
      </div>
      <div class="filter-wrap" id="filters-deposits">
        <button class="filter-btn active" data-filter="all">Tous</button>
        <button class="filter-btn" data-filter="validated">Validés</button>
        <button class="filter-btn" data-filter="pending">En attente</button>
        <button class="filter-btn" data-filter="rejected">Rejetés</button>
      </div>
    </div>

    <% if @deposits.any? %>
      <table class="data-table" id="table-deposits">
        <thead>
          <tr>
            <th>Date</th>
            <th>Agent</th>
            <th>Client</th>
            <th>Montant</th>
            <th>Référence</th>
            <th>Statut</th>
          </tr>
        </thead>
        <tbody>
          <% @deposits.each do |d| %>
            <%
              sc = case d.status.to_s.downcase
                when "validated","validé","valide" then "status-validated"
                when "pending","en attente"         then "status-pending"
                when "rejected","rejeté","rejete"  then "status-rejected"
                else "status-default"
              end
              sl = case d.status.to_s.downcase
                when "validated","validé","valide" then "Validé"
                when "pending","en attente"         then "En attente"
                when "rejected","rejeté","rejete"  then "Rejeté"
                else d.status.to_s.humanize
              end
            %>
            <tr data-status="<%= d.status.to_s.downcase %>">
              <td class="td-date"><%= d.created_at.strftime("%d/%m/%Y %H:%M") %></td>
              <td>
                <div class="td-agent">
                  <div class="agent-avatar"><%= d.user.email.first.upcase %></div>
                  <span class="agent-email"><%= d.user.email %></span>
                </div>
              </td>
              <td>
                <div class="td-phone">
                  <div class="phone-avatar avatar-dep"><%= d.client_phone.to_s.first.upcase %></div>
                  <%= d.client_phone %>
                </div>
              </td>
              <td class="td-amount amount-dep">+ <%= number_with_delimiter(d.amount, delimiter: " ") %> FCFA</td>
              <td><span class="td-ref"><%= d.reference %></span></td>
              <td><span class="status-badge <%= sc %>"><%= sl %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <p>Aucun dépôt enregistré.</p>
      </div>
    <% end %>
  </div>
</div>

<!-- ══════════════ RETRAITS PANEL ══════════════ -->
<div class="tab-panel" id="panel-withdrawals">
  <div class="table-card">
    <div class="table-toolbar">
      <div class="search-wrap">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input type="text" class="search-input" id="search-withdrawals" placeholder="Agent, client, référence…" style="--focus-color: var(--amber);">
      </div>
      <div class="filter-wrap" id="filters-withdrawals">
        <button class="filter-btn active" data-filter="all">Tous</button>
        <button class="filter-btn" data-filter="validated">Validés</button>
        <button class="filter-btn" data-filter="pending">En attente</button>
        <button class="filter-btn" data-filter="rejected">Rejetés</button>
      </div>
    </div>

    <% if @withdrawals.any? %>
      <table class="data-table withdraw-table" id="table-withdrawals">
        <thead>
          <tr>
            <th>Date</th>
            <th>Agent</th>
            <th>Client</th>
            <th>Montant</th>
            <th>Référence</th>
            <th>Statut</th>
          </tr>
        </thead>
        <tbody>
          <% @withdrawals.each do |w| %>
            <%
              sc = case w.status.to_s.downcase
                when "validated","validé","valide" then "status-validated"
                when "pending","en attente"         then "status-pending"
                when "rejected","rejeté","rejete"  then "status-rejected"
                else "status-default"
              end
              sl = case w.status.to_s.downcase
                when "validated","validé","valide" then "Validé"
                when "pending","en attente"         then "En attente"
                when "rejected","rejeté","rejete"  then "Rejeté"
                else w.status.to_s.humanize
              end
            %>
            <tr data-status="<%= w.status.to_s.downcase %>">
              <td class="td-date"><%= w.created_at.strftime("%d/%m/%Y %H:%M") %></td>
              <td>
                <div class="td-agent">
                  <div class="agent-avatar"><%= w.user.email.first.upcase %></div>
                  <span class="agent-email"><%= w.user.email %></span>
                </div>
              </td>
              <td>
                <div class="td-phone">
                  <div class="phone-avatar avatar-wit"><%= w.client_phone.to_s.first.upcase %></div>
                  <%= w.client_phone %>
                </div>
              </td>
              <td class="td-amount amount-wit">− <%= number_with_delimiter(w.amount, delimiter: " ") %> FCFA</td>
              <td><span class="td-ref"><%= w.reference %></span></td>
              <td><span class="status-badge <%= sc %>"><%= sl %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="empty-state">
        <div class="empty-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <p>Aucun retrait enregistré.</p>
      </div>
    <% end %>
  </div>
</div>

<script>
  // ── Tab switching ──
  function switchTab(name, btn) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('panel-' + name).classList.add('active');
    btn.classList.add('active');
  }

  // ── Generic filter/search factory ──
  function initTable(tableId, searchId, filtersId) {
    const search  = document.getElementById(searchId);
    const rows    = document.querySelectorAll('#' + tableId + ' tbody tr');
    const filters = document.getElementById(filtersId);

    function apply() {
      const query  = search ? search.value.toLowerCase() : '';
      const active = filters ? filters.querySelector('.filter-btn.active') : null;
      const status = active ? active.dataset.filter : 'all';

      rows.forEach(row => {
        const text      = row.textContent.toLowerCase();
        const rowStatus = (row.dataset.status || '').toLowerCase();
        const matchText =  text.includes(query);
        const matchStatus =
          status === 'all' ||
          (status === 'validated' && (rowStatus.includes('valid'))) ||
          (status === 'pending'   && (rowStatus.includes('pending') || rowStatus.includes('attente'))) ||
          (status === 'rejected'  && (rowStatus.includes('reject') || rowStatus.includes('rejet')));

        row.style.display = matchText && matchStatus ? '' : 'none';
      });
    }

    if (search) search.addEventListener('input', apply);
    if (filters) {
      filters.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', function () {
          filters.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          apply();
        });
      });
    }
  }

  initTable('table-deposits',    'search-deposits',    'filters-deposits');
  initTable('table-withdrawals', 'search-withdrawals', 'filters-withdrawals');
</script>
