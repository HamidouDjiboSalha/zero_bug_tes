<% content_for :page_title, "Historique des retraits" %>

<style>
  :root {
    --lime: #8dc63f;
    --lime-dark: #6fa32e;
    --lime-muted: #e8f5d0;
    --amber: #f59e0b;
    --amber-dark: #d97706;
    --amber-muted: #fef3c7;
    --charcoal: #1c1f26;
  }
  body { font-family: 'Outfit', sans-serif; }

  /* ── Page header ── */
  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 14px;
  }

  .page-header-left h1 {
    font-size: 20px;
    font-weight: 700;
    color: var(--charcoal);
    margin: 0 0 4px;
    letter-spacing: -0.3px;
  }

  .page-header-left p {
    font-size: 13px;
    color: #9ca3af;
    margin: 0;
  }

  .total-badge {
    background: var(--amber-muted);
    border: 1.5px solid var(--amber);
    color: var(--amber-dark);
    font-size: 13px;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 12px;
    white-space: nowrap;
  }

  /* ── Table card ── */
  .table-card {
    background: white;
    border-radius: 18px;
    box-shadow: 0 2px 20px rgba(28,31,38,0.07);
    border: 1.5px solid #f0f0f0;
    overflow: hidden;
  }

  .table-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1.5px solid #f3f4f6;
    gap: 12px;
    flex-wrap: wrap;
  }

  .search-wrap {
    position: relative;
    flex: 1;
    max-width: 280px;
    min-width: 160px;
  }

  .search-wrap svg {
    position: absolute;
    left: 11px; top: 50%;
    transform: translateY(-50%);
    width: 15px; height: 15px;
    color: #9ca3af;
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 9px 12px 9px 34px;
    border: 1.5px solid #e5e7eb;
    border-radius: 9px;
    font-size: 13px;
    font-family: 'Outfit', sans-serif;
    color: var(--charcoal);
    background: #fafafa;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .search-input:focus {
    border-color: var(--amber);
    box-shadow: 0 0 0 3px rgba(245,158,11,0.12);
    background: white;
  }

  .filter-wrap {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 7px 13px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    font-family: 'Outfit', sans-serif;
    border: 1.5px solid #e5e7eb;
    background: white;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.12s;
  }

  .filter-btn:hover,
  .filter-btn.active {
    border-color: var(--amber);
    color: var(--amber-dark);
    background: var(--amber-muted);
  }

  /* ── Data table ── */
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }

  .data-table thead {
    background: #fffdf5;
    border-bottom: 1.5px solid #fde68a;
  }

  .data-table thead th {
    padding: 12px 18px;
    text-align: left;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #9ca3af;
    white-space: nowrap;
  }

  .data-table tbody tr {
    border-bottom: 1px solid #f3f4f6;
    transition: background 0.1s;
  }

  .data-table tbody tr:last-child { border-bottom: none; }
  .data-table tbody tr:hover { background: #fffdf5; }

  .data-table td {
    padding: 13px 18px;
    color: var(--charcoal);
    vertical-align: middle;
  }

  .td-date { color: #6b7280; font-size: 12.5px; white-space: nowrap; }

  .td-phone {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    white-space: nowrap;
  }

  .phone-avatar {
    width: 30px; height: 30px;
    border-radius: 8px;
    background: var(--amber-muted);
    color: var(--amber-dark);
    font-size: 12px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .td-amount {
    font-weight: 700;
    font-size: 14px;
    color: var(--amber-dark);
    white-space: nowrap;
  }

  .td-ref {
    font-family: 'Courier New', monospace;
    font-size: 12px;
    color: #9ca3af;
    background: #f3f4f6;
    padding: 3px 8px;
    border-radius: 6px;
    white-space: nowrap;
    display: inline-block;
  }

  /* Status badges */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 99px;
    font-size: 11.5px;
    font-weight: 600;
    white-space: nowrap;
  }

  .status-badge::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .status-validated  { background: var(--lime-muted); color: var(--lime-dark); }
  .status-validated::before { background: var(--lime); }

  .status-pending    { background: var(--amber-muted); color: var(--amber-dark); }
  .status-pending::before { background: var(--amber); }

  .status-rejected   { background: #fef2f2; color: #dc2626; }
  .status-rejected::before { background: #ef4444; }

  .status-default    { background: #f3f4f6; color: #6b7280; }
  .status-default::before { background: #9ca3af; }

  /* Empty state */
  .empty-state {
    padding: 48px 32px;
    text-align: center;
  }

  .empty-icon {
    width: 56px; height: 56px;
    background: #f3f4f6;
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 14px;
  }

  .empty-icon svg { width: 26px; height: 26px; color: #d1d5db; }
  .empty-state p  { color: #9ca3af; font-size: 14px; margin: 0; }
</style>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- ── Page header ── -->
<div class="page-header">
  <div class="page-header-left">
    <h1>Historique des retraits</h1>
    <p><%= @withdrawals.size %> transaction<%= @withdrawals.size > 1 ? "s" : "" %> enregistrée<%= @withdrawals.size > 1 ? "s" : "" %></p>
  </div>
  <% if @withdrawals.any? %>
    <div class="total-badge">
      Total : − <%= number_with_delimiter(@withdrawals.sum(&:amount), delimiter: " ") %> FCFA
    </div>
  <% end %>
</div>

<!-- ── Table card ── -->
<div class="table-card">

  <!-- Toolbar -->
  <div class="table-toolbar">
    <div class="search-wrap">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <input type="text" class="search-input" id="table-search"
             placeholder="Rechercher client, référence…">
    </div>

    <div class="filter-wrap">
      <button class="filter-btn active" data-filter="all">Tous</button>
      <button class="filter-btn" data-filter="validated">Validés</button>
      <button class="filter-btn" data-filter="pending">En attente</button>
      <button class="filter-btn" data-filter="rejected">Rejetés</button>
    </div>
  </div>

  <!-- Table -->
  <% if @withdrawals.any? %>
    <table class="data-table" id="withdrawals-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Client</th>
          <th>Montant</th>
          <th>Référence</th>
          <th>Statut</th>
        </tr>
      </thead>
      <tbody>
        <% @withdrawals.each do |w| %>
          <%
            status_class = case w.status.to_s.downcase
              when "validated", "validé", "valide" then "status-validated"
              when "pending", "en attente"          then "status-pending"
              when "rejected", "rejeté", "rejete"  then "status-rejected"
              else "status-default"
            end

            status_label = case w.status.to_s.downcase
              when "validated", "validé", "valide" then "Validé"
              when "pending", "en attente"          then "En attente"
              when "rejected", "rejeté", "rejete"  then "Rejeté"
              else w.status.to_s.humanize
            end
          %>
          <tr data-status="<%= w.status.to_s.downcase %>">
            <td class="td-date"><%= w.created_at.strftime("%d/%m/%Y %H:%M") %></td>
            <td>
              <div class="td-phone">
                <div class="phone-avatar"><%= w.client_phone.to_s.first.upcase %></div>
                <%= w.client_phone %>
              </div>
            </td>
            <td class="td-amount">− <%= number_with_delimiter(w.amount, delimiter: " ") %> FCFA</td>
            <td><span class="td-ref"><%= w.reference %></span></td>
            <td><span class="status-badge <%= status_class %>"><%= status_label %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-state">
      <div class="empty-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M20 12H4"/>
        </svg>
      </div>
      <p>Aucun retrait enregistré pour le moment.</p>
    </div>
  <% end %>

</div>

<script>
  const searchInput = document.getElementById('table-search');
  const rows = document.querySelectorAll('#withdrawals-table tbody tr');

  function filterRows() {
    const query  = searchInput ? searchInput.value.toLowerCase() : '';
    const active = document.querySelector('.filter-btn.active');
    const status = active ? active.dataset.filter : 'all';

    rows.forEach(row => {
      const text      = row.textContent.toLowerCase();
      const rowStatus = row.dataset.status || '';
      const matchText = text.includes(query);
      const matchStatus =
        status === 'all' ||
        (status === 'validated' && (rowStatus.includes('valid') || rowStatus.includes('validé'))) ||
        (status === 'pending'   && (rowStatus.includes('pending') || rowStatus.includes('attente'))) ||
        (status === 'rejected'  && (rowStatus.includes('reject') || rowStatus.includes('rejet')));

      row.style.display = matchText && matchStatus ? '' : 'none';
    });
  }

  if (searchInput) searchInput.addEventListener('input', filterRows);

  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      filterRows();
    });
  });
</script>
