<% content_for :page_title, "Nouveau dépôt" %>

<style>
  :root {
    --lime: #8dc63f;
    --lime-dark: #6fa32e;
    --lime-light: #a8d85a;
    --lime-muted: #e8f5d0;
    --charcoal: #1c1f26;
  }
  body { font-family: 'Outfit', sans-serif; }

  .form-page {
    max-width: 520px;
  }

  /* ── Card ── */
  .form-card {
    background: white;
    border-radius: 20px;
    box-shadow: 0 4px 32px rgba(28,31,38,0.07);
    border: 1.5px solid #f0f0f0;
    overflow: hidden;
  }

  .form-card-header {
    background: var(--charcoal);
    padding: 24px 30px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .form-card-icon {
    width: 44px; height: 44px;
    background: var(--lime);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .form-card-icon svg { width: 22px; height: 22px; color: white; }

  .form-card-header h2 {
    color: white;
    font-size: 18px;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.3px;
  }

  .form-card-header p {
    color: rgba(255,255,255,0.45);
    font-size: 13px;
    margin: 3px 0 0;
  }

  .form-card-body {
    padding: 30px;
  }

  /* ── Fields ── */
  .form-group {
    margin-bottom: 22px;
  }

  .form-group label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--charcoal);
    margin-bottom: 8px;
    letter-spacing: 0.1px;
  }

  .input-wrap {
    position: relative;
  }

  .input-prefix {
    position: absolute;
    left: 14px; top: 50%;
    transform: translateY(-50%);
    font-size: 13px;
    font-weight: 600;
    color: #9ca3af;
    pointer-events: none;
    user-select: none;
  }

  .input-suffix {
    position: absolute;
    right: 14px; top: 50%;
    transform: translateY(-50%);
    font-size: 12px;
    font-weight: 600;
    color: #9ca3af;
    pointer-events: none;
    user-select: none;
    background: #f3f4f6;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .form-group input {
    width: 100%;
    padding: 12px 14px;
    border: 1.5px solid #e5e7eb;
    border-radius: 11px;
    font-size: 14px;
    font-family: 'Outfit', sans-serif;
    color: var(--charcoal);
    background: #fafafa;
    transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    box-sizing: border-box;
    outline: none;
  }

  .form-group input.has-prefix  { padding-left: 44px; }
  .form-group input.has-suffix  { padding-right: 70px; }

  .form-group input:focus {
    border-color: var(--lime);
    background: white;
    box-shadow: 0 0 0 3px rgba(141,198,63,0.15);
  }

  .form-group input::placeholder { color: #c4c9d4; }

  /* ── Amount preview ── */
  .amount-preview {
    margin-top: 8px;
    padding: 10px 14px;
    background: var(--lime-muted);
    border-radius: 9px;
    font-size: 13px;
    font-weight: 600;
    color: var(--lime-dark);
    display: none;
    align-items: center;
    gap: 7px;
  }

  .amount-preview svg { width: 15px; height: 15px; flex-shrink: 0; }

  /* ── Divider ── */
  .form-divider {
    height: 1px;
    background: #f3f4f6;
    margin: 4px 0 24px;
  }

  /* ── Submit ── */
  .submit-btn {
    width: 100%;
    padding: 14px;
    background: var(--lime);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 700;
    font-family: 'Outfit', sans-serif;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s, box-shadow 0.15s;
    letter-spacing: 0.2px;
    box-shadow: 0 4px 14px rgba(141,198,63,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
  }

  .submit-btn:hover {
    background: var(--lime-dark);
    box-shadow: 0 6px 20px rgba(141,198,63,0.4);
    transform: translateY(-1px);
  }

  .submit-btn:active { transform: translateY(0); }
  .submit-btn svg { width: 18px; height: 18px; }

  /* ── Info note ── */
  .info-note {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 16px;
    padding: 12px 14px;
    background: #f8faf5;
    border: 1.5px solid #e8f5d0;
    border-radius: 10px;
    font-size: 12.5px;
    color: #6b7280;
    line-height: 1.5;
  }

  .info-note svg { width: 15px; height: 15px; color: var(--lime-dark); flex-shrink: 0; margin-top: 1px; }
</style>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="form-page">
  <div class="form-card">

    <div class="form-card-header">
      <div class="form-card-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 4v16m8-8H4"/>
        </svg>
      </div>
      <div>
        <h2>Nouveau dépôt</h2>
        <p>Enregistrez un dépôt pour un client</p>
      </div>
    </div>

    <div class="form-card-body">
      <%= form_with model: @deposit, local: true do |f| %>

        <!-- Numéro client -->
        <div class="form-group">
          <%= f.label :client_phone, "Numéro du client" %>
          <div class="input-wrap">
            <span class="input-prefix">
              <svg style="width:15px;height:15px;display:inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498A1 1 0 0121 15.72V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </span>
            <%= f.text_field :client_phone,
                placeholder: "90xxxxxx",
                required: true,
                class: "has-prefix",
                inputmode: "tel",
                maxlength: 8 %>
          </div>
        </div>

        <!-- Montant -->
        <div class="form-group">
          <%= f.label :amount, "Montant" %>
          <div class="input-wrap">
            <%= f.number_field :amount,
                min: 100,
                required: true,
                class: "has-suffix",
                placeholder: "0",
                id: "deposit_amount_field",
                inputmode: "numeric" %>
            <span class="input-suffix">FCFA</span>
          </div>
          <div class="amount-preview" id="amount-preview">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span id="amount-preview-text"></span>
          </div>
        </div>

        <div class="form-divider"></div>

        <!-- Submit -->
        <div>
          <%= f.submit class: "submit-btn" do %>
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M5 13l4 4L19 7"/>
            </svg>
            Valider le dépôt
          <% end %>
        </div>

        <div class="info-note">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Le dépôt sera enregistré et soumis à validation. Assurez-vous que le numéro client et le montant sont corrects avant de soumettre.
        </div>

      <% end %>
    </div>

  </div>
</div>

<script>
  const amountField = document.getElementById('deposit_amount_field');
  const preview     = document.getElementById('amount-preview');
  const previewText = document.getElementById('amount-preview-text');

  function formatNumber(n) {
    return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
  }

  amountField.addEventListener('input', function () {
    const val = parseInt(this.value, 10);
    if (val && val >= 100) {
      previewText.textContent = 'Montant : ' + formatNumber(val) + ' FCFA';
      preview.style.display = 'flex';
    } else {
      preview.style.display = 'none';
    }
  });
</script>
