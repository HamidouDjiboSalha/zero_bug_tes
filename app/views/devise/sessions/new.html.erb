<style>
  :root {
    --lime: #8dc63f;
    --lime-dark: #6fa32e;
    --lime-light: #a8d85a;
    --lime-muted: #e8f5d0;
    --charcoal: #1c1f26;
  }

  .auth-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8faf5;
    font-family: 'Outfit', sans-serif;
    padding: 24px;
  }

  .auth-card {
    background: white;
    border-radius: 20px;
    box-shadow: 0 4px 40px rgba(28,31,38,0.08);
    width: 100%;
    max-width: 420px;
    overflow: hidden;
  }

  .auth-header {
    background: var(--charcoal);
    padding: 32px 36px 28px;
    text-align: center;
  }

  .auth-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .auth-logo-i {
    width: 36px; height: 36px;
    background: var(--lime);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 18px; color: white;
  }

  .auth-logo-text {
    font-size: 22px;
    font-weight: 600;
    color: white;
  }

  .auth-logo-text span { color: var(--lime); }

  .auth-header h2 {
    color: white;
    font-size: 20px;
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.3px;
  }

  .auth-header p {
    color: rgba(255,255,255,0.5);
    font-size: 13.5px;
    margin: 6px 0 0;
  }

  .auth-body {
    padding: 32px 36px 24px;
  }

  .form-group {
    margin-bottom: 18px;
  }

  .form-group label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--charcoal);
    margin-bottom: 7px;
    letter-spacing: 0.1px;
  }

  .form-group input[type="email"],
  .form-group input[type="password"] {
    width: 100%;
    padding: 11px 14px;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    font-size: 14px;
    font-family: 'Outfit', sans-serif;
    color: var(--charcoal);
    background: #fafafa;
    transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    box-sizing: border-box;
    outline: none;
  }

  .form-group input:focus {
    border-color: var(--lime);
    background: white;
    box-shadow: 0 0 0 3px rgba(141,198,63,0.15);
  }

  /* Remember me */
  .remember-row {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 22px;
  }

  .remember-row input[type="checkbox"] {
    width: 17px;
    height: 17px;
    accent-color: var(--lime);
    cursor: pointer;
    flex-shrink: 0;
    border-radius: 5px;
  }

  .remember-row label {
    font-size: 13px;
    color: #6b7280;
    font-weight: 500;
    cursor: pointer;
    margin: 0;
  }

  .submit-btn {
    width: 100%;
    padding: 13px;
    background: var(--lime);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    font-family: 'Outfit', sans-serif;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s, box-shadow 0.15s;
    letter-spacing: 0.2px;
    box-shadow: 0 4px 14px rgba(141,198,63,0.35);
  }

  .submit-btn:hover {
    background: var(--lime-dark);
    box-shadow: 0 6px 18px rgba(141,198,63,0.4);
    transform: translateY(-1px);
  }

  .submit-btn:active {
    transform: translateY(0);
  }

  /* Divider with label */
  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 22px 0;
  }

  .divider::before,
  .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #e5e7eb;
  }

  .divider span {
    font-size: 12px;
    color: #9ca3af;
    font-weight: 500;
  }

  /* Payment CTA */
  .payment-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    background: white;
    color: var(--charcoal);
    border: 1.5px solid #e5e7eb;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Outfit', sans-serif;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
  }

  .payment-btn:hover {
    border-color: var(--lime);
    background: var(--lime-muted);
    box-shadow: 0 2px 10px rgba(141,198,63,0.15);
  }

  .payment-btn svg {
    width: 17px; height: 17px;
    color: var(--lime-dark);
  }

  .auth-footer {
    padding: 0 36px 28px;
    text-align: center;
  }

  .auth-footer a {
    color: var(--lime-dark);
    font-size: 13.5px;
    text-decoration: none;
    font-weight: 500;
  }

  .auth-footer a:hover {
    text-decoration: underline;
  }

  /* Error messages */
  #error_explanation {
    background: #fef2f2;
    border: 1.5px solid #fca5a5;
    border-radius: 10px;
    padding: 12px 16px;
    margin-bottom: 20px;
  }

  #error_explanation h2 {
    color: #dc2626;
    font-size: 13px;
    font-weight: 600;
    margin: 0 0 8px;
  }

  #error_explanation ul {
    margin: 0;
    padding-left: 18px;
  }

  #error_explanation ul li {
    color: #dc2626;
    font-size: 12.5px;
    margin-bottom: 3px;
  }
</style>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="auth-wrapper">
  <div class="auth-card">

    <div class="auth-header">
      <div class="auth-logo">
        <div class="auth-logo-i">i</div>
        <span class="auth-logo-text"><span>i</span>money</span>
      </div>
      <h2>Connexion</h2>
      <p>Bienvenue, entrez vos identifiants</p>
    </div>

    <div class="auth-body">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-group">
          <%= f.label :email, "Adresse e-mail" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "exemple@email.com" %>
        </div>

        <div class="form-group">
          <%= f.label :password, "Mot de passe" %>
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="remember-row">
            <%= f.check_box :remember_me %>
            <%= f.label :remember_me, "Se souvenir de moi" %>
          </div>
        <% end %>

        <div class="actions">
          <%= f.submit "Se connecter", class: "submit-btn" %>
        </div>
      <% end %>

      <div class="divider"><span>ou</span></div>

      <%= link_to payment_check_path, class: "payment-btn" do %>
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
        </svg>
        Accéder au Paiement
      <% end %>
    </div>

    <div class="auth-footer">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>
